# Application Environment ('development' or 'production')
APP_NAME="Cloud-Based IoT Sensor Monitoring & Anomaly Detection System"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security & JWT Authentication
# In production, generate a secure random 256-bit string: openssl rand -hex 32
SECRET_KEY=change-this-to-a-strong-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial User Provisioning (Local Demonstration Default - Change in Production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change-this-viewer-password

# Database Configuration
# Local SQLite Default (Zero configuration required for local dev):
DATABASE_URL=sqlite:///./iot_sensor.db
# PostgreSQL Container / Cloud Production Configuration:
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
POSTGRES_USER=iot_admin
POSTGRES_PASSWORD=replace_with_secure_db_password
POSTGRES_DB=iot_monitoring_db

# ==============================================================================
# MQTT Telemetry Ingestion Provider ('local' or 'aws')
# ==============================================================================
MQTT_PROVIDER=local

# ------------------------------------------------------------------------------
# 1. LOCAL MODE SETTINGS (Active when MQTT_PROVIDER=local)
# ------------------------------------------------------------------------------
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_TOPIC_PREFIX=iot/sensors/
MQTT_CLIENT_ID=iot_fastapi_backend_consumer
MQTT_USERNAME=iot_backend
MQTT_PASSWORD=replace_with_secure_mqtt_password
MQTT_USE_TLS=False

# ------------------------------------------------------------------------------
# 2. AWS CLOUD MODE SETTINGS (Active when MQTT_PROVIDER=aws)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_IOT_ENDPOINT=your-prefix-ats.iot.us-east-1.amazonaws.com
AWS_IOT_PORT=8883
AWS_IOT_KEEPALIVE=60
AWS_IOT_TOPIC=industrial/sensors/+/telemetry
AWS_IOT_BACKEND_CLIENT_ID=iot-fastapi-backend-consumer
AWS_IOT_ROOT_CA_PATH=certs/AmazonRootCA1.pem
AWS_IOT_CERT_PATH=certs/SENSOR-001.cert.pem
AWS_IOT_PRIVATE_KEY_PATH=certs/SENSOR-001.private.key
AWS_IOT_BACKEND_CERT_PATH=certs/backend-consumer.cert.pem
AWS_IOT_BACKEND_PRIVATE_KEY_PATH=certs/backend-consumer.private.key

# Machine Learning Anomaly Detection Configuration
ML_MODEL_PATH=backend/ml/isolation_forest_model.joblib
ML_CONTAMINATION=0.05
ML_RANDOM_STATE=42

# Simulator Settings
SIMULATOR_INTERVAL_SECONDS=1.5
SIMULATOR_ANOMALY_PROBABILITY=0.10
SIMULATOR_AUTORUN=False

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:3000
