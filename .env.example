# Application Configuration
APP_NAME="Cloud-Based IoT Sensor Monitoring & Anomaly Detection System"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security & JWT Authentication
SECRET_KEY=industrial-iot-secret-key-change-in-production-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to local SQLite, cloud-ready for PostgreSQL)
# For SQLite local development:
DATABASE_URL=sqlite:///./iot_sensor.db
# For PostgreSQL production:
# DATABASE_URL=postgresql://iot_user:iot_secure_pass@localhost:5432/iot_monitoring_db

# MQTT Broker Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_TOPIC_PREFIX=iot/sensors/
MQTT_CLIENT_ID=iot_fastapi_backend_consumer
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=False

# Machine Learning Anomaly Detection Configuration
ML_MODEL_PATH=backend/ml/isolation_forest_model.joblib
ML_CONTAMINATION=0.05
ML_RANDOM_STATE=42

# Simulator Settings
SIMULATOR_INTERVAL_SECONDS=1.5
SIMULATOR_ANOMALY_PROBABILITY=0.10
SIMULATOR_AUTORUN=False

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
